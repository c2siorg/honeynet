# Fluent Bit configuration — ships Cowrie JSON logs to S3
# Generated by Ansible for sensor: {{ sensor_name }}

[SERVICE]
    Flush         5
    Daemon        Off
    Log_Level     info
    Parsers_File  parsers.conf

[INPUT]
    Name              tail
    Path              {{ cowrie_log_path }}
    Tag               cowrie.attacks
    Parser            json
    DB                /var/log/flb_cowrie.db
    Mem_Buf_Limit     5MB
    Skip_Long_Lines   On
    Refresh_Interval  10

[FILTER]
    Name    record_modifier
    Match   cowrie.*
    Record  sensor_id {{ sensor_name }}
    Record  cloud_provider {{ cloud_provider | default('unknown') }}

[OUTPUT]
    Name                         s3
    Match                        cowrie.*
    bucket                       {{ s3_bucket }}
    region                       {{ aws_region }}
    store_dir                    /tmp/fluent-bit-s3
    s3_key_format                /raw/{{ sensor_name }}/%Y/%m/%d/%H-%M-%S.json
    total_file_size              10M
    upload_timeout               60s
    use_put_object               On
    compression                  gzip
    content_type                 application/x-ndjson
